{
  "name": "twelve-paper-shadows",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:crazygames": "tsc --noEmit && vite build --mode crazygames && cd dist-crazygames && rm -f ../star-keeper-crazygames.zip && zip -qr ../star-keeper-crazygames.zip .",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vite": "6.4.4",
    "vitest": "3.2.7"
  },
  "dependencies": {
    "@fontsource/fraunces": "5.3.0",
    "@fontsource/noto-serif": "5.3.0"
  }
}
